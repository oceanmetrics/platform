{
  "name": "@oceanmetrics/places",
  "version": "0.5.2",
  "description": "client for the Ocean Metrics places gazetteer: layers manifest, MapLibre layers from PMTiles, parquet search and lookups, credits",
  "keywords": [
    "ocean",
    "gazetteer",
    "places",
    "maplibre",
    "pmtiles",
    "parquet"
  ],
  "homepage": "https://github.com/oceanmetrics/platform/tree/main/packages/places#readme",
  "bugs": {
    "url": "https://github.com/oceanmetrics/platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanmetrics/platform.git",
    "directory": "packages/places"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "hyparquet": "^1.30.1",
    "hyparquet-compressors": "^1.1.1"
  },
  "peerDependencies": {
    "pmtiles": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "pmtiles": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "typescript": "~5.9.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/places"
  }
}
