{
  "about": "the storage url rule's case table, shared by @oceanmetrics/catalog/storage (storage.test.ts) and om_extract.storage (tests/test_storage.py): the two implementations must give these outputs exactly",
  "parse": [
    { "name": "a name", "value": "storage", "output": "https://storage.oceanmetrics.io" },
    { "name": "a name: s3", "value": "s3", "output": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public" },
    { "name": "a name: preview", "value": "preview", "output": "https://om-gazetteer.ben-f07.workers.dev" },
    { "name": "a constant name", "value": "S3_PATH_STYLE", "output": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public" },
    { "name": "an https url, trailing slash dropped", "value": "https://storage-next.marinesensitivity.org/", "output": "https://storage-next.marinesensitivity.org" },
    { "name": "a dev server", "value": "http://localhost:8787", "output": "http://localhost:8787" },
    { "name": "spaces trimmed", "value": "  storage  ", "output": "https://storage.oceanmetrics.io" },
    { "name": "empty", "value": "", "output": null },
    { "name": "plain http elsewhere is refused", "value": "http://storage.oceanmetrics.io", "output": null },
    { "name": "a query string is refused", "value": "https://example.org/?x=1", "output": null },
    { "name": "not a url", "value": "bucket", "output": null },
    { "name": "an inherited property name is not a name", "value": "toString", "output": null }
  ],
  "storageUrl": [
    { "name": "the default host", "key": "indicators/indicators.json", "output": "https://storage.oceanmetrics.io/indicators/indicators.json" },
    { "name": "a prefix keeps its slash", "key": "gazetteer/", "host": "storage", "output": "https://storage.oceanmetrics.io/gazetteer/" },
    { "name": "a leading slash dropped", "key": "/obis-h3/collection.json", "host": "https://storage.oceanmetrics.io/", "output": "https://storage.oceanmetrics.io/obis-h3/collection.json" },
    { "name": "a malformed host falls back to the default", "key": "atlas/catalog.json", "host": "ftp://x", "output": "https://storage.oceanmetrics.io/atlas/catalog.json" },
    { "name": "the reader's key", "key": "atlas-restricted/01ABC/x/collection.json", "host": "preview", "apiKey": "k 1", "output": "https://om-gazetteer.ben-f07.workers.dev/atlas-restricted/01ABC/x/collection.json?key=k%201" },
    { "name": "the reader's key after a query", "key": "marine-atlas/cog/a.tif?b=2", "host": "storage", "apiKey": "abc", "output": "https://storage.oceanmetrics.io/marine-atlas/cog/a.tif?b=2&key=abc" }
  ],
  "rewrite": [
    { "name": "s3 to storage", "from": "S3_PATH_STYLE", "to": "STORAGE_HOST",
      "input": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/indicators/indicators.json",
      "output": "https://storage.oceanmetrics.io/indicators/indicators.json", "count": 1 },
    { "name": "storage to s3 (the rollback)", "from": "STORAGE_HOST", "to": "S3_PATH_STYLE",
      "input": "https://storage.oceanmetrics.io/indicators/indicators.json",
      "output": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/indicators/indicators.json", "count": 1 },
    { "name": "the band key and the query kept", "from": "s3", "to": "storage",
      "input": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/marine-atlas/cog/global05/a.tif?b=2#x",
      "output": "https://storage.oceanmetrics.io/marine-atlas/cog/global05/a.tif?b=2#x", "count": 1 },
    { "name": "a restricted url keeps its key", "from": "s3", "to": "storage",
      "input": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/atlas-restricted/01ABC/x/collection.json?key=abc",
      "output": "https://storage.oceanmetrics.io/atlas-restricted/01ABC/x/collection.json?key=abc", "count": 1 },
    { "name": "the bare host", "from": "s3", "to": "storage",
      "input": "{\"href\": \"https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public\"}",
      "output": "{\"href\": \"https://storage.oceanmetrics.io\"}", "count": 1 },
    { "name": "two urls in a JSON text, bytes kept", "from": "s3", "to": "storage",
      "input": "{\n  \"links\": [{\"rel\":\"self\",\"href\":\"https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/obis-h3/collection.json\"},\n    {\"rel\": \"item\", \"href\": \"https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/obis-h3/v1/a.parquet\"}]\n}\n",
      "output": "{\n  \"links\": [{\"rel\":\"self\",\"href\":\"https://storage.oceanmetrics.io/obis-h3/collection.json\"},\n    {\"rel\": \"item\", \"href\": \"https://storage.oceanmetrics.io/obis-h3/v1/a.parquet\"}]\n}\n", "count": 2 },
    { "name": "a markdown link in a description", "from": "s3", "to": "storage",
      "input": "see [the data](https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/indicators/README.md).",
      "output": "see [the data](https://storage.oceanmetrics.io/indicators/README.md).", "count": 1 },
    { "name": "the virtual-hosted form with the path-style one", "from": ["S3_PATH_STYLE", "S3_VIRTUAL_HOST"], "to": "storage",
      "input": "https://oceanmetrics.io-public.s3.amazonaws.com/gazetteer/a.json https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public/gazetteer/b.json",
      "output": "https://storage.oceanmetrics.io/gazetteer/a.json https://storage.oceanmetrics.io/gazetteer/b.json", "count": 2 },
    { "name": "a Marine Regions tile url is not changed", "from": ["s3", "s3-virtual", "storage", "preview"], "to": "storage",
      "input": "https://geo.vliz.be/geoserver/gwc/service/wmts?layer=MarineRegions:eez&style=&tilematrixset=EPSG:900913&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/png&TileMatrix=EPSG:900913:{z}&TileCol={x}&TileRow={y}",
      "output": "https://geo.vliz.be/geoserver/gwc/service/wmts?layer=MarineRegions:eez&style=&tilematrixset=EPSG:900913&Service=WMTS&Request=GetTile&Version=1.0.0&Format=image/png&TileMatrix=EPSG:900913:{z}&TileCol={x}&TileRow={y}", "count": 0 },
    { "name": "an ERDDAP url is not changed", "from": ["s3", "storage"], "to": "preview",
      "input": "https://erddap.oceanmetrics.io/erddap/griddap/jplMURSST41.csv?analysed_sst%5B(last)%5D https://coastwatch.pfeg.noaa.gov/erddap/griddap/NOAA_DHW.json",
      "output": "https://erddap.oceanmetrics.io/erddap/griddap/jplMURSST41.csv?analysed_sst%5B(last)%5D https://coastwatch.pfeg.noaa.gov/erddap/griddap/NOAA_DHW.json", "count": 0 },
    { "name": "another bucket whose name begins with ours is not changed", "from": "s3", "to": "storage",
      "input": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public-logs/x.json",
      "output": "https://s3.us-east-1.amazonaws.com/oceanmetrics.io-public-logs/x.json", "count": 0 },
    { "name": "a host that begins with storage's name is not changed", "from": "storage", "to": "s3",
      "input": "https://storage.oceanmetrics.io.example.org/gazetteer/x.json",
      "output": "https://storage.oceanmetrics.io.example.org/gazetteer/x.json", "count": 0 },
    { "name": "an already rebased url is not changed", "from": "s3", "to": "storage",
      "input": "https://storage.oceanmetrics.io/indicators/coverage.parquet",
      "output": "https://storage.oceanmetrics.io/indicators/coverage.parquet", "count": 0 }
  ]
}
