{
  "name": "@oceanmetrics/catalog",
  "version": "0.4.0",
  "description": "the Ocean Metrics catalogs: STAC layer profiles (JSON Schemas, types, a validator and the om-catalog CLI), the values contract, and the indicators readers and cards",
  "keywords": [
    "ocean",
    "stac",
    "json-schema",
    "catalog",
    "indicators",
    "gazetteer"
  ],
  "homepage": "https://github.com/oceanmetrics/platform/tree/main/packages/catalog#readme",
  "bugs": {
    "url": "https://github.com/oceanmetrics/platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanmetrics/platform.git",
    "directory": "packages/catalog"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./indicators": {
      "types": "./dist/indicators.d.ts",
      "default": "./dist/indicators.js"
    },
    "./cards": {
      "types": "./dist/cards.d.ts",
      "default": "./dist/cards.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "om-catalog": "dist/cli.js"
  },
  "dependencies": {
    "@oceanmetrics/status": "^0.1.1",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "hyparquet": "^1.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/catalog"
  }
}
