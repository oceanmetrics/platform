{
  "name": "@oceanmetrics/map",
  "version": "0.2.1",
  "description": "the map stack of the Ocean Metrics apps: MapLibre 6, PMTiles, the bathymetric basemap, COG and H3 sources",
  "keywords": [
    "ocean",
    "maplibre",
    "pmtiles",
    "cog",
    "h3",
    "basemap"
  ],
  "homepage": "https://github.com/oceanmetrics/platform/tree/main/packages/map#readme",
  "bugs": {
    "url": "https://github.com/oceanmetrics/platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanmetrics/platform.git",
    "directory": "packages/map"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./h3-worker": {
      "types": "./dist/h3Worker.d.ts",
      "default": "./dist/h3Worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/h3Worker.js",
    "./src/h3Worker.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/map"
  },
  "dependencies": {
    "@geomatico/maplibre-cog-protocol": "^0.10.0",
    "@maplibre/geojson-vt": "^6.3.0",
    "@maplibre/vt-pbf": "^4.3.2",
    "geotiff": "^3.0.5",
    "h3-js": "^4.4.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.13.0",
    "pmtiles": "^4.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.1"
  }
}
