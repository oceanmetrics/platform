{
  "name": "@oceanmetrics/status",
  "version": "0.1.0",
  "description": "status methods of Ocean Metrics indicators: iea-sd, names-pct, values; period grid, sentences and alt text; the quadrant plot rules",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/status"
  }
}
