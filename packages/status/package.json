{
  "name": "@oceanmetrics/status",
  "version": "0.1.0",
  "description": "status methods of Ocean Metrics indicators: iea-sd, names-pct, values; period grid, sentences and alt text; the quadrant plot rules",
  "keywords": [
    "ocean",
    "indicators",
    "status",
    "time-series",
    "iea",
    "ecosystem-indicators"
  ],
  "homepage": "https://github.com/oceanmetrics/platform/tree/main/packages/status#readme",
  "bugs": {
    "url": "https://github.com/oceanmetrics/platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanmetrics/platform.git",
    "directory": "packages/status"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/status"
  }
}
